diff --git a/hen/README.md b/hen/README.md
index 3a8f363..57718f3 100644
--- a/hen/README.md
+++ b/hen/README.md
@@ -64,3 +64,27 @@ When the player holds R while starting a native game, HEN lets the game's
 process start with the homebrew loader in place of the game. The first such
 launch runs the game normally while HEN saves its signed policy to the SD
 card; later launches start hbloader, which runs hbmenu.
+
+A Switch 1 game, which Switch 2 runs in compatibility mode, keeps its
+Switch 1 program ID, and Loader mounts its code with no content attributes.
+Loader loads all of its modules (`rtld`, `main`, `subsdk*`, `sdk`) from that
+mount, so the package that HEN swaps in has to be built from the title's
+own ExeFS, with hbloader in place of `rtld`. HEN looks for it at
+`/kaihen/bin/s1/<program ID>.nsp` on the SD card, the program ID as 16
+lowercase hex digits. A title whose own package is absent, or does not open,
+uses `/kaihen/bin/s1/default.nsp` instead. Loader reads the title's own
+`main.npdm` before HEN swaps the package in, so the title's policy (64-bit
+or 32-bit, address space, memory) governs the donor's modules. A default
+built from another 64-bit Switch 1 game has started hbmenu from other
+Switch 1 games in testing; a 32-bit game is not expected to work with it. With a package that Loader accepts, an R
+launch of the game starts hbmenu; with one it refuses, the launch ends and
+the game can be started again; with neither, the game starts normally, and
+while it runs HEN builds `default.nsp` from that game's ExeFS and hbloader
+(`/kaihen/bin/game/main`), so that the next R launch of that game, and of
+other 64-bit Switch 1 games, starts hbmenu. HEN writes it as
+`default.nsp.part` and renames it only once it is complete. A 32-bit
+game, or any build refused before copying starts, leaves the build to a
+later game; a game that exits during the copy, or a copy that fails, leaves
+no `default.nsp` and uses up that HEN session's one build. HEN does not
+build the per-title packages. A Switch 1 title does not need a saved native
+policy, so it can be the first R launch after a fresh install.
diff --git a/hen/source/donor_build.cpp b/hen/source/donor_build.cpp
new file mode 100644
index 0000000..1c51570
--- /dev/null
+++ b/hen/source/donor_build.cpp
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <cstring>
+#include "donor_build.hpp"
+#include "game_title.hpp"
+#include "../../common/result.hpp"
+#include "../../common/sd_writer.hpp"
+
+namespace {
+
+constexpr Result InvalidDonor = MAKERESULT(Module_Libnx, LibnxError_BadInput);
+/// FS's result for a path that does not exist.
+constexpr Result PathNotFound = MAKERESULT(2, 1);
+/// FS's result for a path that already exists.
+constexpr Result PathAlreadyExists = MAKERESULT(2, 2);
+/// Most bytes one step() copies. HEN serves its IPC between steps.
+constexpr size_t DonorChunk = 0x10000;
+alignas(0x1000) u8 g_donor_chunk[DonorChunk];
+/// The title's ExeFS listing, kept off HEN's stack; one build runs at a time.
+ounce::game::DonorFile g_donor_title[ounce::game::DonorFileLimit];
+
+/// Fails unless `path` names nothing on the SD card.
+Result checkAbsent(FsFileSystem* sd, const char* path) {
+    FsDirEntryType type = FsDirEntryType_File;
+    const Result rc = fsFsGetEntryType(sd, path, &type);
+    if (R_SUCCEEDED(rc)) return PathAlreadyExists;
+    return rc == PathNotFound ? 0 : rc;
+}
+
+/// Opens a title's code file system: readSignedPolicy's fsp-ldr command 0,
+/// OpenCodeFileSystem (common/policy_package.cpp), on the borrowed Loader root.
+Result openCodeFileSystem(Handle loader_root, u64 program_id, u8 storage_id, u8 attributes,
+                          FsFileSystem* out) {
+    R_UNLESS(loader_root != INVALID_HANDLE, InvalidDonor);
+    Service loader = {};
+    serviceCreate(&loader, loader_root);
+    loader.own_handle = false;
+    const struct {
+        u8 attributes;
+        u8 storage_id;
+        u64 program_id;
+    } request = {attributes, storage_id, program_id};
+    u8 code_info[0x1a4] = {};
+    *out = {};
+    return serviceDispatchIn(&loader, 0, request,
+        .buffer_attrs = {SfBufferAttr_HipcMapAlias | SfBufferAttr_Out},
+        .buffers = {{code_info, sizeof(code_info)}},
+        .out_num_objects = 1,
+        .out_objects = &out->s,
+    );
+}
+
+/// "/<name>" in FS's path buffer, for a name that isDonorName takes.
+void codePath(char (&out)[FS_MAX_PATH], const char* name) {
+    static_assert(ounce::game::DonorNameLimit + 2 <= FS_MAX_PATH);
+    out[0] = '/';
+    std::memcpy(out + 1, name, std::strlen(name) + 1);
+}
+
+} // namespace
+
+ounce::game::DonorPlan& donorPlanStorage() {
+    static ounce::game::DonorPlan plan = {};
+    return plan;
+}
+
+Switch1DonorBuild::~Switch1DonorBuild() {
+    abandon();
+}
+
+void Switch1DonorBuild::abandon() {
+    if (source_open_) {
+        fsFileClose(&source_);
+        source_open_ = false;
+    }
+    if (part_open_) {
+        fsFileClose(&part_);
+        part_open_ = false;
+    }
+    if (part_created_ && sd_open_) {
+        fsFsDeleteFile(&sd_, ounce::game::Switch1DefaultDonorPart);
+        fsFsCommit(&sd_);
+    }
+    part_created_ = false;
+    if (sd_open_) {
+        fsFsClose(&sd_);
+        sd_open_ = false;
+    }
+    if (code_open_) {
+        fsFsClose(&code_);
+        code_open_ = false;
+    }
+}
+
+Result Switch1DonorBuild::begin(Handle loader_root, Handle fs_root, u64 program_id,
+                                u8 storage_id, const char* hbloader_path) {
+    abandon();
+    position_ = 0;
+    copied_ = 0;
+    written_ = 0;
+    plan_.count = 0;
+    stage_ = Stage_CodeFileSystem;
+    const auto run = [&]() -> Result {
+        R_UNLESS(hbloader_path && std::strlen(hbloader_path) < sizeof(hbloader_path_),
+                 InvalidDonor);
+        std::strcpy(hbloader_path_, hbloader_path);
+        R_TRY(openCodeFileSystem(loader_root, program_id, storage_id,
+                                 ounce::game::Switch1CodeAttributes, &code_));
+        code_open_ = true;
+
+        stage_ = Stage_List;
+        ounce::game::DonorFile* const title = g_donor_title;
+        std::memset(g_donor_title, 0, sizeof(g_donor_title));
+        u32 title_count = 0;
+        R_TRY(listTitle(title, title_count));
+        stage_ = Stage_Policy;
+        R_TRY(checkPolicy());
+
+        stage_ = Stage_SdCard;
+        R_TRY(openSdCardFileSystem(fs_root, &sd_));
+        sd_open_ = true;
+        stage_ = Stage_DonorAbsent;
+        R_TRY(checkAbsent(&sd_, ounce::game::Switch1DefaultDonorFile));
+
+        stage_ = Stage_Hbloader;
+        FsFile hbloader = {};
+        R_TRY(fsFsOpenFile(&sd_, hbloader_path_, FsOpenMode_Read, &hbloader));
+        s64 hbloader_size = 0;
+        const Result size_rc = fsFileGetSize(&hbloader, &hbloader_size);
+        fsFileClose(&hbloader);
+        R_TRY(size_rc);
+        R_UNLESS(hbloader_size > 0, InvalidDonor);
+
+        stage_ = Stage_Plan;
+        R_UNLESS(ounce::game::planDonor(title, title_count, static_cast<u64>(hbloader_size),
+                                        plan_),
+                 InvalidDonor);
+
+        // A part file left by an earlier HEN session that stopped mid-copy is
+        // replaced; nothing opens it.
+        stage_ = Stage_CreatePart;
+        const char* part = ounce::game::Switch1DefaultDonorPart;
+        R_TRY(createSdParents(&sd_, part));
+        FsDirEntryType type = FsDirEntryType_Dir;
+        if (R_SUCCEEDED(fsFsGetEntryType(&sd_, part, &type))) {
+            R_UNLESS(type == FsDirEntryType_File, InvalidDonor);
+            R_TRY(fsFsDeleteFile(&sd_, part));
+        }
+        R_TRY(fsFsCreateFile(&sd_, part, static_cast<s64>(plan_.size), 0));
+        part_created_ = true;
+        R_TRY(fsFsOpenFile(&sd_, part, FsOpenMode_Write, &part_));
+        part_open_ = true;
+        R_TRY(fsFileWrite(&part_, 0, plan_.header, plan_.header_size, FsWriteOption_None));
+        written_ = plan_.header_size;
+        stage_ = Stage_Copy;
+        R_SUCCEED();
+    };
+    const Result rc = run();
+    if (R_FAILED(rc)) abandon();
+    return rc;
+}
+
+Result Switch1DonorBuild::listTitle(ounce::game::DonorFile* title, u32& count) {
+    count = 0;
+    char root[FS_MAX_PATH] = "/";
+    FsDir directory = {};
+    R_TRY(fsFsOpenDirectory(&code_, root, FsDirOpenMode_ReadDirs | FsDirOpenMode_ReadFiles,
+                            &directory));
+    Result rc = 0;
+    for (;;) {
+        FsDirectoryEntry entry = {};
+        s64 read = 0;
+        rc = fsDirRead(&directory, &read, 1, &entry);
+        if (R_FAILED(rc) || read == 0) break;
+        entry.name[sizeof(entry.name) - 1] = '\0';
+        // A donor is flat: a directory, a name a donor does not take, or too
+        // many files refuses the whole title.
+        if (read != 1 || entry.type != FsDirEntryType_File || entry.file_size < 0 ||
+            count == ounce::game::DonorFileLimit ||
+            !ounce::game::isDonorName(entry.name)) {
+            rc = InvalidDonor;
+            break;
+        }
+        ounce::game::DonorFile& file = title[count++];
+        std::strcpy(file.name, entry.name);
+        file.size = static_cast<u64>(entry.file_size);
+        file.hbloader = false;
+    }
+    fsDirClose(&directory);
+    return rc;
+}
+
+Result Switch1DonorBuild::checkPolicy() {
+    char path[FS_MAX_PATH] = {};
+    codePath(path, "main.npdm");
+    FsFile file = {};
+    R_TRY(fsFsOpenFile(&code_, path, FsOpenMode_Read, &file));
+    u8 meta[ounce::game::MetaFlagsOffset + 1] = {};
+    u64 read = 0;
+    Result rc = fsFileRead(&file, 0, meta, sizeof(meta), FsReadOption_None, &read);
+    fsFileClose(&file);
+    R_TRY(rc);
+    R_UNLESS(ounce::game::isDonorPolicy(meta, read), InvalidDonor);
+    R_SUCCEED();
+}
+
+Result Switch1DonorBuild::step(bool& complete) {
+    complete = false;
+    Result rc = InvalidDonor;
+    if (part_open_) {
+        rc = position_ < plan_.count ? copyChunk() : finish(complete);
+    }
+    if (R_FAILED(rc)) abandon();
+    return rc;
+}
+
+Result Switch1DonorBuild::openSource() {
+    const ounce::game::DonorFile& file = plan_.files[position_];
+    char path[FS_MAX_PATH] = {};
+    if (file.hbloader) {
+        std::strcpy(path, hbloader_path_);
+    } else {
+        codePath(path, file.name);
+    }
+    R_TRY(fsFsOpenFile(file.hbloader ? &sd_ : &code_, path, FsOpenMode_Read, &source_));
+    source_open_ = true;
+    copied_ = 0;
+    s64 size = 0;
+    R_TRY(fsFileGetSize(&source_, &size));
+    // The file must still be the size that the header gives it.
+    R_UNLESS(size >= 0 && static_cast<u64>(size) == file.size, InvalidDonor);
+
+    // Up to 31 zero bytes align the file's data.
+    const u64 offset = plan_.offsets[position_];
+    R_UNLESS(written_ <= offset && offset - written_ < 0x20, InvalidDonor);
+    if (offset > written_) {
+        const u8 padding[0x20] = {};
+        R_TRY(fsFileWrite(&part_, static_cast<s64>(written_), padding, offset - written_,
+                          FsWriteOption_None));
+        written_ = offset;
+    }
+    R_SUCCEED();
+}
+
+Result Switch1DonorBuild::copyChunk() {
+    if (!source_open_) R_TRY(openSource());
+    const ounce::game::DonorFile& file = plan_.files[position_];
+    const u64 left = file.size - copied_;
+    const u64 wanted = left < DonorChunk ? left : DonorChunk;
+    if (wanted) {
+        u64 received = 0;
+        R_TRY(fsFileRead(&source_, static_cast<s64>(copied_), g_donor_chunk, wanted,
+                         FsReadOption_None, &received));
+        R_UNLESS(received == wanted, InvalidDonor);
+        if (!copied_) {
+            // The module and policy files must be what Loader expects.
+            const char* magic = ounce::game::donorMagic(file.name);
+            R_UNLESS(!magic || (wanted >= 4 && !std::memcmp(g_donor_chunk, magic, 4)),
+                     InvalidDonor);
+        }
+        R_TRY(fsFileWrite(&part_, static_cast<s64>(written_), g_donor_chunk, wanted,
+                          FsWriteOption_None));
+        copied_ += wanted;
+        written_ += wanted;
+    } else {
+        // An empty file has no magic: only one without a required magic is taken.
+        R_UNLESS(!ounce::game::donorMagic(file.name), InvalidDonor);
+    }
+    if (copied_ == file.size) {
+        fsFileClose(&source_);
+        source_open_ = false;
+        position_++;
+    }
+    R_SUCCEED();
+}
+
+Result Switch1DonorBuild::finish(bool& complete) {
+    stage_ = Stage_Finish;
+    R_UNLESS(written_ == plan_.size, InvalidDonor);
+    Result rc = fsFileFlush(&part_);
+    fsFileClose(&part_);
+    part_open_ = false;
+    R_TRY(rc);
+    R_TRY(fsFsCommit(&sd_));
+    // A donor that appeared meanwhile is kept; this build is dropped.
+    R_TRY(checkAbsent(&sd_, ounce::game::Switch1DefaultDonorFile));
+    R_TRY(fsFsRenameFile(&sd_, ounce::game::Switch1DefaultDonorPart,
+                         ounce::game::Switch1DefaultDonorFile));
+    part_created_ = false;
+    complete = true;
+    rc = fsFsCommit(&sd_);
+    abandon();
+    return rc;
+}
diff --git a/hen/source/donor_build.hpp b/hen/source/donor_build.hpp
new file mode 100644
index 0000000..3fcfa4a
--- /dev/null
+++ b/hen/source/donor_build.hpp
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+#include <switch.h>
+#include "donor_layout.hpp"
+
+/// Builds the shared Switch 1 donor (game_title.hpp Switch1DefaultDonorFile)
+/// from a running Switch 1 title's ExeFS, in bounded steps. The package is
+/// written to Switch1DefaultDonorPart and renamed only once every byte is
+/// written and committed; any failure, and abandon(), deletes the part file,
+/// so the donor's name never holds a partial package.
+/// The one DonorPlan a Switch1DonorBuild uses, kept off HEN's stack.
+ounce::game::DonorPlan& donorPlanStorage();
+
+class Switch1DonorBuild {
+  public:
+    /// Where a build stopped, for the trace: bits 8 and up of trace().
+    enum Stage : u32 {
+        Stage_CodeFileSystem = 1,
+        Stage_List = 2,
+        Stage_Policy = 3,
+        Stage_SdCard = 4,
+        Stage_DonorAbsent = 5,
+        Stage_Hbloader = 6,
+        Stage_Plan = 7,
+        Stage_CreatePart = 8,
+        Stage_Copy = 9,
+        Stage_Finish = 10,
+    };
+
+    ~Switch1DonorBuild();
+
+    /// Lists the title's code file system, plans the donor and writes its
+    /// header to the part file. A failure has already abandoned the build.
+    Result begin(Handle loader_root, Handle fs_root, u64 program_id, u8 storage_id,
+                 const char* hbloader_path);
+    /// Copies at most one chunk; once every file is copied, commits the part
+    /// file and renames it, and sets `complete`. A failure has already
+    /// abandoned the build.
+    Result step(bool& complete);
+    /// Closes every file and deletes the part file, if it exists.
+    void abandon();
+    /// The stage reached in bits 8 and up, the package file index in the low byte.
+    u32 trace() const { return (stage_ << 8) | (position_ & 0xff); }
+    u32 count() const { return plan_.count; }
+
+  private:
+    Result listTitle(ounce::game::DonorFile* title, u32& count);
+    Result checkPolicy();
+    Result openSource();
+    Result copyChunk();
+    Result finish(bool& complete);
+
+    FsFileSystem code_ = {};
+    FsFileSystem sd_ = {};
+    FsFile source_ = {};
+    FsFile part_ = {};
+    bool code_open_ = false;
+    bool sd_open_ = false;
+    bool source_open_ = false;
+    bool part_open_ = false;
+    /// The part file exists on SD and is this build's to delete.
+    bool part_created_ = false;
+    u32 stage_ = 0;
+    /// The package file being copied.
+    u32 position_ = 0;
+    /// Bytes of that file already copied.
+    u64 copied_ = 0;
+    /// Bytes of the part file already written.
+    u64 written_ = 0;
+    char hbloader_path_[FS_MAX_PATH] = {};
+    /// File-static storage (donor_build.cpp): only one build runs at a time.
+    ounce::game::DonorPlan& plan_ = donorPlanStorage();
+};
diff --git a/hen/source/donor_layout.hpp b/hen/source/donor_layout.hpp
new file mode 100644
index 0000000..6119fff
--- /dev/null
+++ b/hen/source/donor_layout.hpp
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+// The layout of a Switch 1 title's donor package: a flat PFS0 holding
+// hbloader as rtld and the title's other ExeFS files, in the order and with
+// the header that writeExeFsPackage (common/policy_package.cpp) uses for two
+// files. Only the libnx types, so that host tests build it.
+extern "C" {
+#include <switch/types.h>
+}
+
+namespace ounce::game {
+
+/// Most files a donor holds, and most files a title's ExeFS may list.
+constexpr u32 DonorFileLimit = 24;
+/// Longest ExeFS file name a donor takes.
+constexpr size_t DonorNameLimit = 64;
+/// Largest ExeFS file a donor takes.
+constexpr u64 DonorFileSizeLimit = 0x10000000;
+/// PFS0 header, one 24-byte entry per file, then the names.
+constexpr size_t DonorHeaderCapacity =
+    16 + DonorFileLimit * 24 + DonorFileLimit * (DonorNameLimit + 1);
+
+struct DonorFile {
+    char name[DonorNameLimit + 1];
+    u64 size;
+    /// The file is hbloader from SD, not one of the title's.
+    bool hbloader;
+};
+
+struct DonorPlan {
+    /// The package's files, in package order.
+    DonorFile files[DonorFileLimit];
+    /// Where each file's data starts, from the start of the package.
+    u64 offsets[DonorFileLimit];
+    u32 count;
+    /// The PFS0 header, entries and names: header[0, header_size).
+    u32 header_size;
+    /// The whole package; the last file is not padded.
+    u64 size;
+    u8 header[DonorHeaderCapacity];
+};
+
+namespace donor_detail {
+
+constexpr size_t length(const char* text) {
+    size_t count = 0;
+    while (text[count]) count++;
+    return count;
+}
+
+constexpr int compare(const char* left, const char* right) {
+    while (*left && *left == *right) {
+        left++;
+        right++;
+    }
+    return static_cast<unsigned char>(*left) - static_cast<unsigned char>(*right);
+}
+
+constexpr bool startsWith(const char* text, const char* prefix) {
+    while (*prefix) {
+        if (*text++ != *prefix++) return false;
+    }
+    return true;
+}
+
+/// The digits of "subsdk<digits>", or nullptr for any other name.
+constexpr const char* subsdkDigits(const char* name) {
+    if (!startsWith(name, "subsdk") || !name[6]) return nullptr;
+    for (const char* digit = name + 6; *digit; digit++) {
+        if (*digit < '0' || *digit > '9') return nullptr;
+    }
+    return name + 6;
+}
+
+/// rtld, main, subsdk<n>, sdk, any other file, main.npdm.
+constexpr u32 rank(const char* name) {
+    if (!compare(name, "rtld")) return 0;
+    if (!compare(name, "main")) return 1;
+    if (subsdkDigits(name)) return 2;
+    if (!compare(name, "sdk")) return 3;
+    if (!compare(name, "main.npdm")) return 5;
+    return 4;
+}
+
+/// Compares two digit strings by value, of any length.
+constexpr int compareNumbers(const char* left, const char* right) {
+    while (*left == '0') left++;
+    while (*right == '0') right++;
+    const size_t left_length = length(left);
+    const size_t right_length = length(right);
+    if (left_length != right_length) return left_length < right_length ? -1 : 1;
+    return compare(left, right);
+}
+
+inline void put32(u8* out, u32 value) {
+    for (int index = 0; index < 4; index++) out[index] = static_cast<u8>(value >> (8 * index));
+}
+
+inline void put64(u8* out, u64 value) {
+    for (int index = 0; index < 8; index++) out[index] = static_cast<u8>(value >> (8 * index));
+}
+
+constexpr u64 align32(u64 value) {
+    return (value + 0x1f) & ~u64(0x1f);
+}
+
+} // namespace donor_detail
+
+/// An ExeFS file name a donor takes: one path component of printable ASCII
+/// without separators or drive marks, at most DonorNameLimit characters.
+constexpr bool isDonorName(const char* name) {
+    if (!name || !name[0]) return false;
+    if (name[0] == '.' && (!name[1] || (name[1] == '.' && !name[2]))) return false;
+    size_t count = 0;
+    for (const char* character = name; *character; character++) {
+        const unsigned char value = static_cast<unsigned char>(*character);
+        if (value <= 0x20 || value >= 0x7f || value == '/' || value == '\\' || value == ':') {
+            return false;
+        }
+        if (++count > DonorNameLimit) return false;
+    }
+    return true;
+}
+
+/// Whether `left` comes before `right` in a donor: rtld, main, subsdk<n> by
+/// the value of n, sdk, any other file by name, then main.npdm. Equal values
+/// of n, and other files, are ordered by name, byte by byte.
+constexpr bool donorBefore(const char* left, const char* right) {
+    const u32 left_rank = donor_detail::rank(left);
+    const u32 right_rank = donor_detail::rank(right);
+    if (left_rank != right_rank) return left_rank < right_rank;
+    if (left_rank == 2) {
+        const int numbers = donor_detail::compareNumbers(donor_detail::subsdkDigits(left),
+                                                         donor_detail::subsdkDigits(right));
+        if (numbers) return numbers < 0;
+    }
+    return donor_detail::compare(left, right) < 0;
+}
+
+/// The magic a donor file must start with: "NSO0" for rtld, main, sdk and
+/// subsdk*, "META" for main.npdm, nullptr for any other file.
+constexpr const char* donorMagic(const char* name) {
+    if (!donor_detail::compare(name, "main.npdm")) return "META";
+    if (!donor_detail::compare(name, "rtld") || !donor_detail::compare(name, "main") ||
+        !donor_detail::compare(name, "sdk") || donor_detail::startsWith(name, "subsdk")) {
+        return "NSO0";
+    }
+    return nullptr;
+}
+
+/// Where main.npdm's META header keeps its flags; bit 0 marks a 64-bit
+/// process. hbloader is 64-bit code, so only a 64-bit title makes a donor.
+constexpr size_t MetaFlagsOffset = 0xc;
+
+/// Whether the start of a main.npdm is a META header for a 64-bit process.
+constexpr bool isDonorPolicy(const u8* meta, size_t size) {
+    return size > MetaFlagsOffset && meta[0] == 'M' && meta[1] == 'E' && meta[2] == 'T' &&
+           meta[3] == 'A' && (meta[MetaFlagsOffset] & 1);
+}
+
+/// Plans a donor from a title's ExeFS listing and hbloader's size: hbloader
+/// as rtld, then every file of the title except its own rtld, in donorBefore
+/// order. False, with `plan` unusable, for a listing that cannot make a donor:
+/// no main or main.npdm, a name isDonorName refuses or that repeats, a file
+/// over DonorFileSizeLimit, or more than DonorFileLimit files.
+inline bool planDonor(const DonorFile* title, u32 title_count, u64 hbloader_size,
+                      DonorPlan& plan) {
+    plan.count = 0;
+    plan.header_size = 0;
+    plan.size = 0;
+    if (title_count > DonorFileLimit || hbloader_size > DonorFileSizeLimit) return false;
+
+    DonorFile& rtld = plan.files[plan.count++];
+    rtld = {};
+    __builtin_memcpy(rtld.name, "rtld", sizeof("rtld"));
+    rtld.size = hbloader_size;
+    rtld.hbloader = true;
+    bool has_main = false;
+    bool has_policy = false;
+    for (u32 index = 0; index < title_count; index++) {
+        const DonorFile& file = title[index];
+        if (!isDonorName(file.name) || file.size > DonorFileSizeLimit) return false;
+        for (u32 other = index + 1; other < title_count; other++) {
+            if (!donor_detail::compare(file.name, title[other].name)) return false;
+        }
+        has_main = has_main || !donor_detail::compare(file.name, "main");
+        has_policy = has_policy || !donor_detail::compare(file.name, "main.npdm");
+        if (!donor_detail::compare(file.name, "rtld")) continue;
+        if (plan.count == DonorFileLimit) return false;
+        DonorFile& entry = plan.files[plan.count++];
+        entry = file;
+        entry.hbloader = false;
+    }
+    if (!has_main || !has_policy) return false;
+
+    // Insertion sort: at most DonorFileLimit files.
+    for (u32 index = 1; index < plan.count; index++) {
+        const DonorFile file = plan.files[index];
+        u32 slot = index;
+        while (slot && donorBefore(file.name, plan.files[slot - 1].name)) {
+            plan.files[slot] = plan.files[slot - 1];
+            slot--;
+        }
+        plan.files[slot] = file;
+    }
+
+    u32 names_size = 0;
+    for (u32 index = 0; index < plan.count; index++) {
+        names_size += static_cast<u32>(donor_detail::length(plan.files[index].name)) + 1;
+    }
+    plan.header_size = 16 + plan.count * 24 + names_size;
+    __builtin_memset(plan.header, 0, sizeof(plan.header));
+    __builtin_memcpy(plan.header, "PFS0", 4);
+    donor_detail::put32(plan.header + 4, plan.count);
+    donor_detail::put32(plan.header + 8, names_size);
+
+    u8* names = plan.header + 16 + plan.count * 24;
+    u32 name_offset = 0;
+    u64 data_end = 0;
+    for (u32 index = 0; index < plan.count; index++) {
+        const DonorFile& file = plan.files[index];
+        // Each file starts 32-byte aligned after the previous one.
+        const u64 offset = index ? donor_detail::align32(data_end) : 0;
+        u8* entry = plan.header + 16 + index * 24;
+        donor_detail::put64(entry, offset);
+        donor_detail::put64(entry + 8, file.size);
+        donor_detail::put32(entry + 16, name_offset);
+        const size_t name_size = donor_detail::length(file.name) + 1;
+        __builtin_memcpy(names + name_offset, file.name, name_size);
+        name_offset += static_cast<u32>(name_size);
+        plan.offsets[index] = plan.header_size + offset;
+        data_end = offset + file.size;
+    }
+    plan.size = plan.header_size + data_end;
+    return true;
+}
